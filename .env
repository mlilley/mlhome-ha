# Configuration for MLHOME-HA docker stack.
# Update *_VOL_* as desired for your storage layout.

# --- GENERAL ---

# Linux timezone string for use by NodeRED and Zigbee2MQTT.
# Ensure it matches host's timezone, with `timedatectl`.
TZ="Australia/Melbourne"

# --- HOME ASSISTANT ---

# Host path to store HomeAssistant's config files
HOMEASSISTANT_VOL_CONFIG="./volumes/homeassistant/config"

# --- ZIGBEE2MQTT ---

# Host path to store Zigbee2MQTT's data files
ZIGBEE2MQTT_VOL_DATA="./volumes/zigbee2mqtt/data"

# --- MOSQUITTO ---

# Host path to store Mosquitto's config files
MOSQUITTO_VOL_CONFIG="./volumes/mosquitto/config"

# Host path to store Mosquitto's data files
MOSQUITTO_VOL_DATA="./volumes/mosquitto/data"

# Host path to store Mosquitto's log files
MOSQUITTO_VOL_LOGS="./volumes/mosquitto/logs"

# --- MQTT EXPLORER ---

# Host path to store MqttExplorer's config files
MQTTEXPLORER_VOL_CONFIG="./volumes/mqtt-explorer/config"

# --- NODERED ---

# Host path to store NodeRED's data files
NODERED_VOL_DATA="./volumes/nodered/data"

# --- TIMESCALEDB ---

# TimescaleDB user account name
TIMESCALE_DB_USER="postgres"

# TimescaleDB user account password
TIMESCALE_DB_PASS="some-password"

# Host path to store TimescaleDB's data files
TIMESCALEDB_VOL_DATA="./volumes/timescaledb/data"
